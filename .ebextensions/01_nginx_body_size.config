# Elastic Beanstalk-only configuration.
#
# WHY THIS FILE EXISTS
#
# On Elastic Beanstalk your Flask app does not face the internet directly.
# nginx listens on port 80 and forwards to Gunicorn on port 8000. nginx has a
# default request body limit of 1 MB, and it enforces that limit ITSELF - the
# request never reaches Flask.
#
# POST /api/backup/restore sends an entire account backup as a JSON body. Once
# an account holds enough transactions for that JSON to pass 1 MB, nginx
# answers 413 and the user sees a failure that no Flask log explains, because
# Flask never saw the request. Locally this never happens: the development
# server has no proxy in front of it, so the limit does not exist.
#
# 20 MB is generous for a JSON backup of this app (the current database is
# 88 KB in total) while still refusing anything absurd.
#
# This changes no application code and no application behaviour. If you ever
# stop using Elastic Beanstalk, delete this file and nothing else changes.

files:
  /etc/nginx/conf.d/01_client_max_body_size.conf:
    mode: "000644"
    owner: root
    group: root
    content: |
      client_max_body_size 20M;
