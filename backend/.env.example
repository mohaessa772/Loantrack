# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored, excluded from Elastic Beanstalk uploads by .ebignore,
# and must NEVER be committed or pasted anywhere.
#
# In production there is no .env file at all: Elastic Beanstalk injects these
# same names as real environment variables, which is why every setting is read
# from the environment rather than hard-coded.


# =====================================================================
# REQUIRED - development and production
# =====================================================================

# Signs the session cookie. Anyone who learns it can forge a login, so it must
# be long, random, and DIFFERENT between your laptop and production.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Which database to use. This single variable is what switches the app between
# SQLite and PostgreSQL - no code changes.
#
# Local development (a file, created automatically):
DATABASE_URL=sqlite:///loantracker.db
#
# Production on Amazon RDS - never commit the real one:
# DATABASE_URL=postgresql://USERNAME:PASSWORD@your-db.abc123.eu-west-1.rds.amazonaws.com:5432/loantrack

# "development" or "production". Anything that is not exactly "production" is
# treated as development, so a typo fails safe.
FLASK_ENV=development


# =====================================================================
# SECURITY
# =====================================================================

# Send the session cookie only over HTTPS.
#
# IMPORTANT ORDER OF OPERATIONS: Elastic Beanstalk gives you a plain http://
# URL first. If you set this to true before HTTPS is actually working, the
# browser silently refuses to send the cookie and login appears broken with no
# error message anywhere. Deploy with false, confirm the site works, add HTTPS,
# THEN set this to true.
SESSION_COOKIE_SECURE=false

# Public sign-up. Leave true just long enough to create your own account on the
# deployed site, then set it to false and redeploy - otherwise anyone who finds
# the URL can create an account on your server.
ALLOW_REGISTRATION=true

# Turns the interactive debugger on. NEVER set this to 1 in production: the
# Werkzeug debugger can execute code straight from the browser.
# Unset means: on in development, off in production.
# FLASK_DEBUG=1


# =====================================================================
# OPTIONAL
# =====================================================================

# Only needed if the frontend is ever served from a DIFFERENT origin than the
# API. In this project Flask serves the React build itself, so requests are
# same-origin and this is unused in production.
CORS_ORIGINS=http://localhost:5173

# Failed sign-in attempts allowed before the caller has to wait.
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_LOCKOUT_SECONDS=300

# Currency shown to a brand new account.
# DEFAULT_CURRENCY=MYR
